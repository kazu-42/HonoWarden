{
  "name": "webauthn-list-disabled",
  "endpoint": {
    "method": "GET",
    "path": "/api/webauthn"
  },
  "request": {
    "headers": {
      "authorization": "Bearer synthetic-access-token"
    }
  },
  "response": {
