{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "honowarden-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-06",
  "preview_urls": false,
  "workers_dev": false,
  "triggers": {
    "crons": ["0 * * * *"],
  },
  "logpush": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "vars": {
    "HONOWARDEN_ACCOUNT_KEYS_ENABLED": "false",
    "HONOWARDEN_ACCOUNT_LIFECYCLE_ENABLED": "false",
    "HONOWARDEN_ALLOWED_EMAILS": "",
    "HONOWARDEN_AUDIT_LOGS": "false",
    "HONOWARDEN_AUTH_REQUESTS_ENABLED": "false",
    "HONOWARDEN_DURABLE_NOTIFICATIONS_ENABLED": "false",
    "HONOWARDEN_BOOTSTRAP_ENABLED": "false",
    "HONOWARDEN_ENV": "development",
    "HONOWARDEN_GLOBAL_REQUEST_QUOTA": "false",
    "HONOWARDEN_KDF_MUTATION_ENABLED": "false",
    "HONOWARDEN_PASSWORD_CHANGE_ENABLED": "false",
    "HONOWARDEN_USER_KEY_ROTATION_ENABLED": "false",
    "HONOWARDEN_PREMIUM_FEATURES_ENABLED": "false",
    "HONOWARDEN_REFRESH_TOKEN_RETENTION_ENABLED": "false",
    "HONOWARDEN_WEBAUTHN_ENABLED": "false",
    "HONOWARDEN_INQUIRY_DOMAINS": "honowarden.com",
    "HONOWARDEN_INQUIRY_MAILBOXES": "security,support,hello,admin,postmaster,abuse",
    "HONOWARDEN_INQUIRY_MAX_RAW_BYTES": "1000000",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "honowarden-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
    },
    {
      "binding": "INQUIRY_DB",
      "database_name": "honowarden-inquiry-local",
      "database_id": "00000000-0000-0000-0000-000000000002",
    },
  ],
  "r2_buckets": [
    {
      "binding": "VAULT_OBJECTS",
      "bucket_name": "honowarden-local-vault-objects",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NOTIFICATION_HUB", "class_name": "NotificationHub" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NotificationHub"] }],
  "env": {
    "staging": {
      "name": "honowarden-staging",
      "preview_urls": false,
      "workers_dev": false,
      "routes": [
        {
          "pattern": "vault-staging.honowarden.com",
          "custom_domain": true,
        },
      ],
      "triggers": {
        "crons": ["0 * * * *"],
      },
      "logpush": true,
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA",
      },
      "vars": {
        "HONOWARDEN_ACCOUNT_KEYS_ENABLED": "false",
        "HONOWARDEN_ACCOUNT_LIFECYCLE_ENABLED": "false",
        "HONOWARDEN_ALLOWED_EMAILS": "",
        "HONOWARDEN_AUDIT_LOGS": "false",
        "HONOWARDEN_AUTH_REQUESTS_ENABLED": "true",
        "HONOWARDEN_DURABLE_NOTIFICATIONS_ENABLED": "true",
        "HONOWARDEN_BOOTSTRAP_ENABLED": "false",
        "HONOWARDEN_ENV": "staging",
        "HONOWARDEN_GLOBAL_REQUEST_QUOTA": "false",
        "HONOWARDEN_KDF_MUTATION_ENABLED": "false",
        "HONOWARDEN_PASSWORD_CHANGE_ENABLED": "false",
        "HONOWARDEN_USER_KEY_ROTATION_ENABLED": "false",
        "HONOWARDEN_PREMIUM_FEATURES_ENABLED": "true",
        "HONOWARDEN_REFRESH_TOKEN_RETENTION_ENABLED": "true",
        "HONOWARDEN_WEBAUTHN_ENABLED": "false",
        "HONOWARDEN_INQUIRY_DOMAINS": "honowarden.com",
        "HONOWARDEN_INQUIRY_MAILBOXES": "security,support,hello,admin,postmaster,abuse",
        "HONOWARDEN_INQUIRY_MAX_RAW_BYTES": "1000000",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "honowarden-staging",
          "database_id": "95cd44de-809f-473c-9972-f892fa32ceb8",
        },
        {
          "binding": "INQUIRY_DB",
          "database_name": "honowarden-inquiry-staging",
          "database_id": "73912ec8-7da4-4e1e-85c8-09ce9c177f9f",
        },
      ],
      "r2_buckets": [
        {
          "binding": "VAULT_OBJECTS",
          "bucket_name": "honowarden-staging-vault-objects",
        },
      ],
      "durable_objects": {
        "bindings": [
          { "name": "NOTIFICATION_HUB", "class_name": "NotificationHub" },
        ],
      },
    },
    "production": {
      "name": "honowarden",
      "preview_urls": false,
      "workers_dev": false,
      "routes": [
        {
          "pattern": "vault.honowarden.com",
          "custom_domain": true,
        },
      ],
      "triggers": {
        "crons": ["0 * * * *"],
      },
      "logpush": true,
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA",
      },
      "vars": {
        "HONOWARDEN_ACCOUNT_KEYS_ENABLED": "false",
        "HONOWARDEN_ACCOUNT_LIFECYCLE_ENABLED": "false",
        "HONOWARDEN_ALLOWED_EMAILS": "",
        "HONOWARDEN_AUDIT_LOGS": "false",
        "HONOWARDEN_AUTH_REQUESTS_ENABLED": "false",
        "HONOWARDEN_DURABLE_NOTIFICATIONS_ENABLED": "false",
        "HONOWARDEN_BOOTSTRAP_ENABLED": "false",
        "HONOWARDEN_ENV": "production",
        "HONOWARDEN_GLOBAL_REQUEST_QUOTA": "false",
        "HONOWARDEN_KDF_MUTATION_ENABLED": "false",
        "HONOWARDEN_PASSWORD_CHANGE_ENABLED": "false",
        "HONOWARDEN_USER_KEY_ROTATION_ENABLED": "false",
        "HONOWARDEN_PREMIUM_FEATURES_ENABLED": "false",
        "HONOWARDEN_REFRESH_TOKEN_RETENTION_ENABLED": "false",
        "HONOWARDEN_WEBAUTHN_ENABLED": "false",
        "HONOWARDEN_INQUIRY_DOMAINS": "honowarden.com",
        "HONOWARDEN_INQUIRY_MAILBOXES": "security,support,hello,admin,postmaster,abuse",
        "HONOWARDEN_INQUIRY_MAX_RAW_BYTES": "1000000",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "honowarden",
          "database_id": "21ef7fa8-f26d-4024-82cb-c7b88ee02433",
        },
        {
          "binding": "INQUIRY_DB",
          "database_name": "honowarden-inquiry",
          "database_id": "00aa46fa-057c-4409-b344-6fa3b61c00dc",
        },
      ],
      "r2_buckets": [
        {
          "binding": "VAULT_OBJECTS",
          "bucket_name": "honowarden-vault-objects",
        },
      ],
      "durable_objects": {
        "bindings": [
          { "name": "NOTIFICATION_HUB", "class_name": "NotificationHub" },
        ],
      },
    },
  },
}
