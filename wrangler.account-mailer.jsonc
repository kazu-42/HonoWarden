{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "honowarden-account-mailer-local",
  "main": "src/account-lifecycle-mail-service.ts",
  "compatibility_date": "2026-07-06",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "send_email": [
    { "name": "EMAIL", "allowed_sender_addresses": ["accounts@example.test"] },
  ],
  "vars": {
    "HONOWARDEN_ACCOUNT_MAIL_SENDER_EMAIL": "accounts@example.test",
    "HONOWARDEN_ACCOUNT_MAIL_ACTIVE_KEY_ID": "account-mail-1",
  },
  "queues": {
    "producers": [
      {
        "binding": "ACCOUNT_LIFECYCLE_DELIVERY_QUEUE",
        "queue": "honowarden-account-mail-local",
      },
    ],
    "consumers": [
      {
        "queue": "honowarden-account-mail-local",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "retry_delay": 60,
        "max_concurrency": 1,
        "dead_letter_queue": "honowarden-account-mail-local-dlq",
      },
    ],
  },
  "env": {
    "staging": {
      "name": "honowarden-account-mailer-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [],
      "observability": { "enabled": true, "head_sampling_rate": 1 },
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": ["no-reply-staging@mail.honowarden.com"],
        },
      ],
      "vars": {
        "HONOWARDEN_ACCOUNT_MAIL_SENDER_EMAIL": "no-reply-staging@mail.honowarden.com",
        "HONOWARDEN_ACCOUNT_MAIL_ACTIVE_KEY_ID": "account-mail-1",
      },
      "queues": {
        "producers": [
          {
            "binding": "ACCOUNT_LIFECYCLE_DELIVERY_QUEUE",
            "queue": "honowarden-account-mail-staging",
          },
        ],
        "consumers": [
          {
            "queue": "honowarden-account-mail-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 1,
            "max_retries": 3,
            "retry_delay": 60,
            "max_concurrency": 1,
            "dead_letter_queue": "honowarden-account-mail-staging-dlq",
          },
        ],
      },
    },
    "production": {
      "name": "honowarden-account-mailer",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [],
      "observability": { "enabled": true, "head_sampling_rate": 1 },
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": ["no-reply@mail.honowarden.com"],
        },
      ],
      "vars": {
        "HONOWARDEN_ACCOUNT_MAIL_SENDER_EMAIL": "no-reply@mail.honowarden.com",
        "HONOWARDEN_ACCOUNT_MAIL_ACTIVE_KEY_ID": "account-mail-1",
      },
      "queues": {
        "producers": [
          {
            "binding": "ACCOUNT_LIFECYCLE_DELIVERY_QUEUE",
            "queue": "honowarden-account-mail",
          },
        ],
        "consumers": [
          {
            "queue": "honowarden-account-mail",
            "max_batch_size": 10,
            "max_batch_timeout": 1,
            "max_retries": 3,
            "retry_delay": 60,
            "max_concurrency": 1,
            "dead_letter_queue": "honowarden-account-mail-dlq",
          },
        ],
      },
    },
  },
}
